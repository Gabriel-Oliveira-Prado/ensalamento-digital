DJANGO_SECRET_KEY=troque-por-uma-chave-segura

DATABASE_ENGINE=postgresql
POSTGRES_DB=ensalamento
POSTGRES_USER=ensalamento
POSTGRES_PASSWORD=ensalamento
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Em serviços de nuvem, normalmente use require.
# Deixe vazio para um PostgreSQL local sem SSL.
POSTGRES_SSLMODE=
